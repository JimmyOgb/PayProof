# ==============================================================================
# PayProof - Environment Configuration Template
# ==============================================================================
# COPY THIS FILE TO .env.local FOR LOCAL DEVELOPMENT.
# DO NOT COMMIT .env OR .env.local TO VERSION CONTROL.
# NEVER PUT PRIVATE KEYS, MNEMONICS, OR SENSITIVE CREDENTIALS IN THIS FILE.
# ==============================================================================

# --- Application Configuration ---
NEXT_PUBLIC_APP_NAME="PayProof"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Arc Mainnet Configuration ---
# Official Chain ID for Arc Mainnet
NEXT_PUBLIC_ARC_CHAIN_ID=5042

# Official Arc Mainnet JSON-RPC endpoint
NEXT_PUBLIC_ARC_RPC_URL="https://rpc.mainnet.arc.io"

# Official Arc Block Explorer
NEXT_PUBLIC_ARC_EXPLORER_URL="https://explorer.arc.io"

# Predeployed official USDC ERC-20 interface address on Arc Mainnet
NEXT_PUBLIC_ARC_USDC_ADDRESS="0x3600000000000000000000000000000000000000"

# (Optional) Optional fallback or dedicated private RPC URL for production reliability
ARC_RPC_FALLBACK_URL=""
